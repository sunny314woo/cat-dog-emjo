# Local MVP adapters implemented; real provider integrations remain unverified.
# Blank credentials, catalog IDs and missing prices are filled by the owner.
# Never copy another product's secrets. All sensitive settings stay server-side.
VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=
VOLCENGINE_MODEL_ID=
# Set a supported mother-image size after a real nine-cell quality test.
VOLCENGINE_FINAL_SIZE=

PADDLE_ENVIRONMENT=
PADDLE_CLIENT_TOKEN=
PADDLE_API_KEY=
PADDLE_PRODUCT_ID=
# New catalog mapping; do not reuse the old $9.99 ID for every entitlement.
PADDLE_PRICE_FIRST_PACK_UNLOCK_ID=
PADDLE_PRICE_PACK_1_ID=
PADDLE_PRICE_PACK_3_ID=
PADDLE_PRICE_PACK_5_ID=
PADDLE_WEBHOOK_SECRET=
PADDLE_CHECKOUT_URL=
# USD figures are draft design values from V2.3, in minor units.
# Missing regional amounts stay blank; disable incomplete live products.
EMJO_PRICE_FIRST_PACK_UNLOCK_USD_MINOR=
EMJO_PRICE_PACK_1_USD_MINOR=
EMJO_PRICE_PACK_3_USD_MINOR=
EMJO_PRICE_PACK_5_USD_MINOR=
EMJO_PRICE_FIRST_PACK_UNLOCK_CNY_MINOR=
EMJO_PRICE_PACK_1_CNY_MINOR=
EMJO_PRICE_PACK_3_CNY_MINOR=
EMJO_PRICE_PACK_5_CNY_MINOR=
EMJO_LOCAL_PRICE_COUNTRY=
EMJO_PRICE_TAX_MODE=

EMJO_PUBLIC_URL=
EMJO_PUBLIC_API_BASE_URL=
# Independent MySQL schema/user. No ORM, no shared account-service tables.
EMJO_MYSQL_HOST=
EMJO_MYSQL_PORT=
EMJO_MYSQL_DATABASE=
EMJO_MYSQL_USER=
EMJO_MYSQL_PASSWORD=
EMJO_BIND_PORT=
EMJO_DATA_DIR=
EMJO_SESSION_SIGNING_SECRET=
EMJO_ORDER_SIGNING_SECRET=
EMJO_MAX_UPLOAD_IMAGES=
EMJO_UPLOAD_MAX_EDGE=
EMJO_UPLOAD_MAX_BYTES=
EMJO_UPLOAD_MAX_PIXELS=
EMJO_GENERATION_CELLS=
EMJO_FREE_STICKERS_PER_GENERATION=
# Proposed free policy: one initial trial, anonymous first, no daily reset.
# Anonymous identity cannot guarantee one trial per real person.
EMJO_FREE_IDENTITY_MODE=
EMJO_FREE_TRIAL_GENERATIONS=
# Budget is an independent daily operational cap, not a daily user benefit.
# Blank must disable real free generation. Limits require operator input.
EMJO_DAILY_FREE_BUDGET_CNY=
EMJO_QUOTA_TIMEZONE=
EMJO_MAX_GENERATION_RETRIES=
EMJO_MAX_CONCURRENT_JOBS=
EMJO_REFUND_WINDOW_DAYS=
# Proposed TTLs; confirm before live release. Never expire Pack balance with images.
EMJO_RAW_UPLOAD_TTL_HOURS=
EMJO_FREE_ASSET_TTL_HOURS=
EMJO_PAID_DELIVERY_TTL_HOURS=
EMJO_DOWNLOAD_LINK_TTL_MINUTES=
EMJO_CHECKOUT_ASSET_HOLD_MINUTES=
# Unused Pack expiry remains a separate pending business rule.
EMJO_PACK_EXPIRY_DAYS=
EMJO_REFERRAL_ENABLED=
EMJO_EMAIL_CODE_TTL_MINUTES=
EMJO_EMAIL_CODE_MAX_ATTEMPTS=
EMJO_EMAIL_CODE_RESEND_COOLDOWN_SECONDS=
# Real alpha processing method to choose after quality/resource validation.
EMJO_BACKGROUND_REMOVAL_MODE=
U2NET_HOME=
EMJO_REQUIRE_STYLE_PREVIEW=

MAIL_PROVIDER=
RESEND_API_KEY=
MAIL_FROM=
MAIL_REPLY_TO=
# Proposed raw ZIP threshold, before Base64 expansion; no default archive/BCC.
MAIL_ZIP_ATTACHMENT_MAX_BYTES=

# Runtime mode: demo by default. Use live only after integration verification.
EMJO_MODE=
EMJO_CALIBRATION_ENABLED=
EMJO_CALIBRATION_MAX_CASES=
EMJO_CALIBRATION_RETENTION_DAYS=
EMJO_COST_PER_GENERATION_CNY=
EMJO_FONT_PATH=

# Optional public API origin for downloadable assets
EMJO_ASSET_URL=
